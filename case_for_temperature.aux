\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Examining the behavior of the canopy longwave radiative effect (CanRE): (a) CanRE vs. \textcolor {black}{$T_{\mathrm  {air}}$}\xspace  for the entirety of the SUMMA model record (2000---2026), (b) The difference between the canopy temperature and \textcolor {black}{$T_{\mathrm  {air}}$}\xspace  as a function of time-of-day in local time (c) the same as (b), but for CanRE, (d) a timeseries of \textcolor {black}{$T_{\mathrm  {air}}$}\xspace  , canopy temperature, and the VIIRS/Suomi-NPP LST product for the CSSL site during the month of March, and (e) a timeseries of CanRF$_{LW}$, CanRF$_{SW}$, and CanRF$_{Net}$ at the CSSL forest site during the March heatwave.}}{21}{figure.9}\protected@file@percent }
\newlabel{fig:canradeffect}{{9}{21}{Examining the behavior of the canopy longwave radiative effect (CanRE): (a) CanRE vs. \tair for the entirety of the SUMMA model record (2000---2026), (b) The difference between the canopy temperature and \tair as a function of time-of-day in local time (c) the same as (b), but for CanRE, (d) a timeseries of \tair , canopy temperature, and the VIIRS/Suomi-NPP LST product for the CSSL site during the month of March, and (e) a timeseries of CanRF$_{LW}$, CanRF$_{SW}$, and CanRF$_{Net}$ at the CSSL forest site during the March heatwave}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces The daily-averaged cCRF$_{Net}$ during March 2026 as simulated by RRTMG for the surface (cCRF$_{Net, sfc}$) and top-of-atmosphere (cCRF$_{Net, TOA}$). }}{21}{figure.10}\protected@file@percent }
\newlabel{fig:cirrus_longwave}{{10}{21}{The daily-averaged cCRF$_{Net}$ during March 2026 as simulated by RRTMG for the surface (cCRF$_{Net, sfc}$) and top-of-atmosphere (cCRF$_{Net, TOA}$)}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces (a) Idealized sensible heat fluxes ($H_s$) into a melting snowpack as a function of \textcolor {black}{$T_{\mathrm  {air}}$}\xspace  for four wind speeds (1, 5, 10, and 15 m s$^{-1}$) at a 12 m height for open-conditions and a snow surface roughness of z$_0$=0.002 m. Dashed lines show neutral-stability bulk transfer; solid lines show the same formulation with a stability correction applied as implemented in SUMMA. (b) the same as (a), but for $H_l$ with a fixed RH of 25\%. (c) The \textcolor {black}{$T_{\mathrm  {air}}$}\xspace  that yields the maximum $H_s$ into a 0 \textcolor {black}{$^\circ $C}\xspace  snowpack after correcting for stability effects (dashed red line) for a given wind speed (u). Contours depict the fraction of the maximum $H_s$ for that wind speed value. (d) The thermodynamic limitation of sublimation as a function of \textcolor {black}{$T_{\mathrm  {air}}$}\xspace  , depicting the maximum RH that permits sublimation from a 0 \textcolor {black}{$^\circ $C}\xspace  snowpack. }}{22}{figure.11}\protected@file@percent }
\newlabel{fig:idealized_sens_heat}{{11}{22}{(a) Idealized sensible heat fluxes ($H_s$) into a melting snowpack as a function of \tair for four wind speeds (1, 5, 10, and 15 m s$^{-1}$) at a 12 m height for open-conditions and a snow surface roughness of z$_0$=0.002 m. Dashed lines show neutral-stability bulk transfer; solid lines show the same formulation with a stability correction applied as implemented in SUMMA. (b) the same as (a), but for $H_l$ with a fixed RH of 25\%. (c) The \tair that yields the maximum $H_s$ into a 0 \degrc snowpack after correcting for stability effects (dashed red line) for a given wind speed (u). Contours depict the fraction of the maximum $H_s$ for that wind speed value. (d) The thermodynamic limitation of sublimation as a function of \tair , depicting the maximum RH that permits sublimation from a 0 \degrc snowpack}{figure.11}{}}
