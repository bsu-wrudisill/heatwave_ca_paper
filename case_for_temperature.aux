\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces March-accumulated surface energy fluxes, snowmelt/cold-content responses, and snow albedo for the open (a--c) and forest (d--f) sites, restricted to hours with SWE~$>$~4~mm. Solid bars gives the accumulated (or, for albedo, the incoming-shortwave-weighted mean) value for March 2026, and the adjacent boxplot (outliers omitted) shows the distribution of the same quantity across all March 1980--2025 water years. (a,d) Monthly-accumulated net shortwave (SW$_{net}$), net longwave (LW$_{net}$), sensible (H$_s$) and latent (H$_l$) heat, and ground heat flux (G) [MJ~m$^{-2}$] for the open (a) and forest (d) sites; The inset in (a) shows the analogous accumulated \textcolor {black}{$SW\downarrow $}\xspace  and \textcolor {black}{$LW\downarrow $}\xspace  radiative forcing. (b,e) Accumulated total snowmelt energy (Melt) and change in snowpack cold content (dCC) for the open (b) and forest (e) sites. (c,f) Shortwave-weighted mean snow albedo ($\alpha $) for the open (c) and forest (f) sites, computed by weighting each hour's albedo by its share of that month's total incoming shortwave radiation.}}{18}{figure.8}\protected@file@percent }
\newlabel{fig:monthly_seb_mar}{{8}{18}{March-accumulated surface energy fluxes, snowmelt/cold-content responses, and snow albedo for the open (a--c) and forest (d--f) sites, restricted to hours with SWE~$>$~4~mm. Solid bars gives the accumulated (or, for albedo, the incoming-shortwave-weighted mean) value for March 2026, and the adjacent boxplot (outliers omitted) shows the distribution of the same quantity across all March 1980--2025 water years. (a,d) Monthly-accumulated net shortwave (SW$_{net}$), net longwave (LW$_{net}$), sensible (H$_s$) and latent (H$_l$) heat, and ground heat flux (G) [MJ~m$^{-2}$] for the open (a) and forest (d) sites; The inset in (a) shows the analogous accumulated \swdn and \lwdn radiative forcing. (b,e) Accumulated total snowmelt energy (Melt) and change in snowpack cold content (dCC) for the open (b) and forest (e) sites. (c,f) Shortwave-weighted mean snow albedo ($\alpha $) for the open (c) and forest (f) sites, computed by weighting each hour's albedo by its share of that month's total incoming shortwave radiation}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces March \textcolor {black}{$SW\downarrow $}\xspace  (a) and \textcolor {black}{$LW\downarrow $}\xspace  (b) anomalies (relative to the March 2000 to present record) from the CERES EBAF 1x1 degree resolution product. (c) and (d) depicts the timeseries of anomalies averaged over the northern Sierra Nevada region in addition to cloud radiative effect amount (red), with units displayed on the right y-axis (in red-text). The shaded region in each plot depicts one standard deviation of the anomaly. }}{19}{figure.9}\protected@file@percent }
\newlabel{fig:ebaf_anomaly}{{9}{19}{March \swdn (a) and \lwdn (b) anomalies (relative to the March 2000 to present record) from the CERES EBAF 1x1 degree resolution product. (c) and (d) depicts the timeseries of anomalies averaged over the northern Sierra Nevada region in addition to cloud radiative effect amount (red), with units displayed on the right y-axis (in red-text). The shaded region in each plot depicts one standard deviation of the anomaly}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces (a) Idealized sensible heat fluxes ($H_s$) into a melting snowpack as a function of \textcolor {black}{$T_{\mathrm  {air}}$}\xspace  for four wind speeds (1, 5, 10, and 15 m s$^{-1}$) at a 12 m height for open-conditions and a snow surface roughness of z$_0$=0.002 m. Dashed lines show neutral-stability bulk transfer; solid lines show the same formulation with a stability correction applied as implemented in SUMMA. (b) the same as (a), but for $H_l$ with a fixed RH of 25\%. (c) The \textcolor {black}{$T_{\mathrm  {air}}$}\xspace  that yields the maximum $H_s$ into a 0 \textcolor {black}{$^\circ $C}\xspace  snowpack after correcting for stability effects (dashed red line) for a given wind speed (u). Contours depict the fraction of the maximum $H_s$ for that wind speed value. (d) The thermodynamic limitation of sublimation as a function of \textcolor {black}{$T_{\mathrm  {air}}$}\xspace  , depicting the maximum RH that permits sublimation from a 0 \textcolor {black}{$^\circ $C}\xspace  snowpack. }}{20}{figure.10}\protected@file@percent }
\newlabel{fig:idealized_sens_heat}{{10}{20}{(a) Idealized sensible heat fluxes ($H_s$) into a melting snowpack as a function of \tair for four wind speeds (1, 5, 10, and 15 m s$^{-1}$) at a 12 m height for open-conditions and a snow surface roughness of z$_0$=0.002 m. Dashed lines show neutral-stability bulk transfer; solid lines show the same formulation with a stability correction applied as implemented in SUMMA. (b) the same as (a), but for $H_l$ with a fixed RH of 25\%. (c) The \tair that yields the maximum $H_s$ into a 0 \degrc snowpack after correcting for stability effects (dashed red line) for a given wind speed (u). Contours depict the fraction of the maximum $H_s$ for that wind speed value. (d) The thermodynamic limitation of sublimation as a function of \tair , depicting the maximum RH that permits sublimation from a 0 \degrc snowpack}{figure.10}{}}
